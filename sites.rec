%rec: site
%doc: Entry in the insecure.club HTTP directory.
%allowed: url ssl cat desc gopher gemini feed css libre button date
%unique: url ssl cat desc gopher gemini feed css libre button date
%mandatory: url ssl cat added
%key: url
%sort: url
%typedef: link size 400
%type: url,gopher,gemini,feed link
%typedef: string size 80
%type: desc,button string
%type: ssl,css,libre bool
%type: added date
%type: cat enum
+ misc
+ personal
+ creative
+ informative
+ technical
+ useful
+ audiovisual
+ interactive
+ social
+ sexual
+ historical
%singular: desc
%singular: gopher
%singular: gemini
%singular: feed
%singular: button
%constraint: !(url ~ '^http')
%constraint: !(gopher ~ '^gopher://')
%constraint: !(gemini ~ '^gemini://')
%constraint: !(gemini ~ '^gemini://')
%constraint: !(feed ~ '^http')
%constraint: !(button ~ '^http')
%constraint: !(button ~ '\.gif$')

